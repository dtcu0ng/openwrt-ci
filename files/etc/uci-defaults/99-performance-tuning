#!/bin/sh
# ============================================================
# JDC AX1800 Pro (IPQ6018) — Runtime Performance Tuning
# ============================================================
# This script applies sysctl and kernel parameter optimisations
# at boot time for maximum network throughput on a 512MB device
# with NSS hardware offloading.
#
# Installed to: /etc/uci-defaults/99-performance-tuning
# Runs ONCE on first boot, then self-deletes.
# ============================================================

cat >> /etc/sysctl.conf << 'SYSCTL_EOF'

# ===== JDC AX1800 Pro Performance Tuning =====

# --- Kernel Stability ---
# Auto-reboot on kernel panic after 10 seconds
# (Set here because KERNEL_PANIC_ON_OOPS/TIMEOUT Kconfig symbols
#  are not exposed in this LiBwrt tree)
kernel.panic_on_oops=1
kernel.panic=10

# --- Memory Management (512MB device) ---
# Low swappiness: prefer keeping data in RAM, use ZRAM only under pressure
vm.swappiness=10
# Keep directory/inode caches longer (faster filesystem ops)
vm.vfs_cache_pressure=50
# Reserve 8MB as emergency free memory to prevent OOM stalls
vm.min_free_kbytes=8192

# --- Connection Tracking (NSS + many-client environments) ---
# 32K connections × ~300 bytes ≈ 10MB — safe for 512MB RAM
net.netfilter.nf_conntrack_max=32768
# Faster connection timeout for transient flows
net.netfilter.nf_conntrack_tcp_timeout_time_wait=30
net.netfilter.nf_conntrack_tcp_timeout_fin_wait=30
net.netfilter.nf_conntrack_udp_timeout=30
net.netfilter.nf_conntrack_udp_timeout_stream=120

# --- TCP/IP Stack Performance ---
# BBR congestion control (loaded via kmod-tcp-bbr)
net.ipv4.tcp_congestion_control=bbr
net.core.default_qdisc=fq

# Increase packet backlog for burst handling
net.core.netdev_max_backlog=8192
net.core.somaxconn=4096

# TCP buffer tuning (optimised for Gigabit throughput on 512MB)
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.core.rmem_default=262144
net.core.wmem_default=262144
net.ipv4.tcp_rmem=4096 262144 16777216
net.ipv4.tcp_wmem=4096 262144 16777216

# Reuse TIME_WAIT sockets
net.ipv4.tcp_tw_reuse=1
# Increase SYN backlog for many-client scenarios
net.ipv4.tcp_max_syn_backlog=4096
# Enable TCP Fast Open (client + server)
net.ipv4.tcp_fastopen=3
# Reduce orphan retries
net.ipv4.tcp_orphan_retries=2
# Increase max orphaned sockets
net.ipv4.tcp_max_orphans=16384

# --- IPv6 ---
net.ipv6.conf.all.accept_ra=2
net.ipv6.conf.default.accept_ra=2

SYSCTL_EOF

# Apply sysctl immediately
sysctl -p >/dev/null 2>&1

# Set conntrack hashsize (nf_conntrack_max / 4 = 8192)
echo 8192 > /sys/module/nf_conntrack/parameters/hashsize 2>/dev/null || true

exit 0
