CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_KERNEL_BUILD_USER="build"
CONFIG_KERNEL_BUILD_DOMAIN="buildbot-actions.ctd.io.vn"
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

#
# ===== Compiler Optimisation =====
#
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -mcpu=cortex-a53+crypto+crc"
CONFIG_DEFAULT_TARGET_OPTIMIZATION="-O3 -pipe -mcpu=cortex-a53+crypto+crc"

#
# ===== Kernel: Scheduler & Timer (Throughput-Optimised) =====
#
# PREEMPT_VOLUNTARY = balanced mode for multi-client routers
# Better responsiveness than NONE when many clients compete, minimal throughput cost
# CONFIG_KERNEL_PREEMPT_NONE is not set
CONFIG_KERNEL_PREEMPT_VOLUNTARY=y
# CONFIG_KERNEL_PREEMPT is not set
# HZ=250 is optimal for routers: low overhead, good latency balance
CONFIG_KERNEL_HZ_250=y
# CONFIG_KERNEL_HZ_100 is not set
# CONFIG_KERNEL_HZ_1000 is not set
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y

#
# ===== Kernel: Stability & Watchdog =====
#
# Auto-reboot on kernel panic after 10 seconds
CONFIG_KERNEL_PANIC_ON_OOPS=y
CONFIG_KERNEL_PANIC_TIMEOUT=10

#
# ===== Kernel: Disable Debug (Reduce Overhead) =====
#
# CONFIG_KERNEL_DEBUG_INFO is not set
# debugfs is REQUIRED for NSS ECM status monitoring (/sys/kernel/debug/ecm/)
CONFIG_KERNEL_DEBUG_FS=y
# CONFIG_KERNEL_DYNAMIC_DEBUG is not set
# kallsyms needed for meaningful kernel crash/oops reports
CONFIG_KERNEL_KALLSYMS=y
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# printk needed for kernel logging — essential for production diagnostics
CONFIG_KERNEL_PRINTK=y

#
# ===== Kernel: Memory (512MB Device) =====
#
# CONFIG_ATH11K_MEM_PROFILE_1G is not set
CONFIG_ATH11K_MEM_PROFILE_512M=y
# CONFIG_IPQ_MEM_PROFILE_1024 is not set
CONFIG_IPQ_MEM_PROFILE_512=y
CONFIG_KERNEL_IPQ_MEM_PROFILE=512
CONFIG_KERNEL_ARM_PMU=y
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_CGROUP_NET_PRIO=y
CONFIG_KERNEL_CGROUP_PERF=y
CONFIG_KERNEL_CFQ_GROUP_IOSCHED=y
CONFIG_KERNEL_MEMCG_SWAP_ENABLED=y
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_KERNEL_PERF_EVENTS=y
# Transparent Hugepages: madvise mode is safer for 512MB device
# (avoids memory fragmentation vs "always" mode)
CONFIG_KERNEL_TRANSPARENT_HUGEPAGE=y
CONFIG_KERNEL_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_KERNEL_TRANSPARENT_HUGEPAGE_ALWAYS is not set
# HugeTLB not needed on 512MB — wastes memory
# CONFIG_KERNEL_HUGETLBFS is not set
# CONFIG_KERNEL_HUGETLB_PAGE is not set
# CONFIG_KERNEL_CGROUP_HUGETLB is not set

#
# ===== ZRAM: LZO-RLE (fastest on ARM Cortex-A53) =====
#
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZORLE=y

#
# ===== Busybox =====
#
CONFIG_BUSYBOX_CONFIG_FEATURE_IPV6=y
CONFIG_BUSYBOX_CONFIG_LSUSB=y

#
# ===== Coremark (Performance Benchmarking) =====
#
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_COREMARK_NUMBER_OF_THREADS=16
CONFIG_COREMARK_OPTIMIZE_O3=y

#
# ===== GnuTLS =====
#
CONFIG_GNUTLS_ALPN=y
CONFIG_GNUTLS_ANON=y
CONFIG_GNUTLS_DTLS_SRTP=y
CONFIG_GNUTLS_HEARTBEAT=y
CONFIG_GNUTLS_OCSP=y
CONFIG_GNUTLS_PSK=y

#
# ===== Libcurl =====
#
CONFIG_LIBCURL_COOKIES=y
CONFIG_LIBCURL_CRYPTO_AUTH=y
CONFIG_LIBCURL_FILE=y
CONFIG_LIBCURL_FTP=y
CONFIG_LIBCURL_HTTP=y
CONFIG_LIBCURL_NGHTTP2=y
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_PROXY=y
CONFIG_LIBCURL_TFTP=y
CONFIG_LIBCURL_THREADED_RESOLVER=y
CONFIG_LIBCURL_TLS_SRP=y
CONFIG_LIBCURL_UNIX_SOCKETS=y

#
# ===== Localisation: English Only =====
#
# CONFIG_LUCI_LANG_zh_Hans is not set
# CONFIG_PACKAGE_default-settings-chn is not set
# CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-base-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-firewall-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-sqm-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-upnp-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-ddns-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn is not set

#
# ============================================================
# ===== NSS (Network Subsystem) Hardware Offloading =====
# ============================================================
#
# --- NSS Driver Feature Flags ---
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_NSS_DRV_L2TP_ENABLE=y
CONFIG_NSS_DRV_LAG_ENABLE=y
CONFIG_NSS_DRV_MAPT_ENABLE=y
CONFIG_NSS_DRV_PPTP_ENABLE=y
CONFIG_NSS_DRV_PVXLAN_ENABLE=y
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_VXLAN_ENABLE=y
CONFIG_NSS_DRV_BRIDGE_ENABLE=y
CONFIG_NSS_DRV_TUN6RD_ENABLE=y
CONFIG_NSS_DRV_TUNIPIP6_ENABLE=y
#
# --- NSS Firmware (v12.5 — latest stable) ---
# CONFIG_NSS_FIRMWARE_VERSION_12_2 is not set
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
#
# --- NSS Kernel Modules ---
CONFIG_PACKAGE_kmod-qca-mcs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vxlanmgr=y
CONFIG_PACKAGE_kmod-qca-nss-macsec=y
#
# --- NSS ECM (Enhanced Connection Manager) ---
# This is the core fast-path engine that offloads flows to NSS hardware
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
#
# --- NSS Conntrack (required for offload flow tracking) ---
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

#
# ============================================================
# ===== Networking: Core =====
# ============================================================
#
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_ds-lite=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-fullconenat=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_xtables-nft=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_resolveip=y

#
# ===== Networking: Kernel Modules =====
#
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-gre6=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-ip6-tunnel=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-extra=y
CONFIG_PACKAGE_kmod-ipt-fullconenat=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-ipt-physdev=y
CONFIG_PACKAGE_kmod-iptunnel4=y
CONFIG_PACKAGE_kmod-iptunnel6=y
CONFIG_PACKAGE_kmod-nat46=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-nf-ipt=y
CONFIG_PACKAGE_kmod-nf-ipt6=y
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-sit=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-vxlan=y

#
# ===== Networking: TCP/QoS Performance =====
#
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-fq=y

#
# ===== Networking: Performance Tools =====
#
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_ethtool-full=y

#
# ===== Crypto =====
